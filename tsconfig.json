{
  "compilerOptions": {
    "jsx": "react",
    "target": "ESNext", // Output JavaScript version
    "module": "ESNext", // Changed from NodeNext to ESNext for browser compatibility
    "rootDir": "src", // Input directory
    "outDir": ".", // Output directory
    "strict": true, // Enable all strict type checks
    "esModuleInterop": false, // For compatibility with CommonJS modules
    "allowSyntheticDefaultImports": true, // Allow default imports for modules without default exports
    "skipLibCheck": true, // Skip type checking of .d.ts files
    "forceConsistentCasingInFileNames": true,
    "noEmitOnError": false, // Emit JS even if there are type errors
    "lib": ["dom"],
    "baseUrl": ".", // Base directory for non-relative module imports
    "paths": {
      "@jest/globals": ["node_modules/@jest/globals"]
    },
    "moduleResolution": "node", // Added for Jest module resolution
    "declaration": false // Disable declaration file generation
  },
  "include": ["src/**/*"], // Files to include
  "exclude": ["node_modules", "dist"] // Folders to ignore
}
